# ==========================================
# LINKUP — GITIGNORE
# ==========================================
#
# Files listed here are never committed or
# pushed to GitHub.
#
# Note: supabase.js is NOT ignored on purpose.
# It only holds the PUBLISHABLE key, which is
# meant to be visible in frontend code. The
# service_role key, secret key and database
# password must never be written to any file
# in this project.


# ------------------------------------------
# Secrets / environment files
# ------------------------------------------
.env
.env.*
*.key
*.pem
secrets.json


# ------------------------------------------
# Operating system junk
# ------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store


# ------------------------------------------
# Editor / IDE
# ------------------------------------------
# .vscode/launch.json and .vscode/tasks.json are both tracked on
# purpose: they are the shared "serve + open LinkUp" debug config,
# and launch.json cannot work without the task it references.
# Only personal VS Code settings stay ignored.
.vscode/settings.json
.idea/
*.swp


# ------------------------------------------
# Node (only if tooling is added later)
# ------------------------------------------
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*


# ------------------------------------------
# Python (only if a Flask backend is added later)
# ------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/


# ------------------------------------------
# Build / temp output
# ------------------------------------------
dist/
build/
*.log
*.tmp
*.bak


# ------------------------------------------
# Internal working notes (AI session logs /
# scratch) — kept OUT of the public repo.
# ------------------------------------------
todos.md
txt/
*.txt
md/CHAT_HISTORY.md
md/CHAT_HISTORY.txt
md/PRESENTATION_WALKTHROUGH.md
md/CURRENT_STATUS.md
md/IMPLEMENTATION_PLAN.md
md/REDESIGN_PROMPT.md
md/ROADMAP.md
ROADMAP.md

# NOTE: md/README.md stays TRACKED so it ships.
#
# AGENTS.md is deliberately NOT ignored. It is committed project
# documentation -- it is how anyone (or any agent) picking this repo up
# learns that .gitignore and .vercelignore are different jobs, and that
# the two SQL files must be edited in pairs. An ignore entry for it
# would be dead config anyway: gitignore has no effect on a file that
# is already tracked.
